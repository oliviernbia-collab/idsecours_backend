PORT=4000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_idsecours

# Générez une valeur longue et aléatoire en production
JWT_SECRET=change-me-idsecours-dev-secret
JWT_USER_TTL=30d
JWT_STAFF_TTL=12h

# Origines autorisées (séparées par des virgules) — web Vite + Expo web
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# URL publique du site web (liens envoyés par SMS aux contacts d'urgence)
PUBLIC_WEB_URL=http://localhost:5173

# simulation : paiements et SMS simulés ; en développement, les codes OTP sont renvoyés dans la réponse (devCode)
PAYMENT_MODE=simulation
SMS_MODE=simulation
